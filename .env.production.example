# Production Environment Configuration
# Copy this to .env.production and fill in the actual values

# Database (Cloud SQL)
# Format: postgresql://user:password@/dbname?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=""

# NextAuth Configuration
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="" # Generate with: openssl rand -base64 32

# Google OAuth (update with production credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gemini API
GEMINI_API_KEY=""

# Email Configuration
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_SERVER_SECURE="true"
EMAIL_FROM="Transcript App <noreply@yourdomain.com>"

# Node Environment
NODE_ENV="production"
