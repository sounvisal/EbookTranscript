generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  passwordHash  String?
  role          String    @default("user") // "admin" | "user"
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  transcripts   Transcript[]
  transcriptCache TranscriptCache[]
  transcriptionJobs TranscriptionJob[]
  metrics       UsageMetric[]
  errors        ErrorLog[]
  createdAt     DateTime  @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Transcript {
  id        String   @id @default(cuid())
  text      String
  source    String   
  filename  String?
  duration  Float?
  wordCount Int?
  language  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cacheId   String?
  cache     TranscriptCache? @relation(fields: [cacheId], references: [id], onDelete: SetNull)
  job       TranscriptionJob?

  @@index([cacheId])
}

model TranscriptionJob {
  id             String      @id
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcriptId   String?     @unique
  transcript     Transcript? @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  fileName       String
  mimeType       String
  keyFingerprint String
  options        Json?
  duration       Float?
  status         String      @default("queued")
  progress       Int         @default(0)
  attempts       Int         @default(0)
  startedAt      DateTime?
  result         Json?
  error          String?
  createdAt      DateTime    @default(now())
  expiresAt      DateTime

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Short-lived cache of transcription results owned by the account that generated them.
model TranscriptCache {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  audioHash String
  text      String
  segments  String?
  language  String?
  duration  Float?
  createdAt DateTime @default(now())
  transcripts Transcript[]

  @@unique([userId, audioHash])
  @@index([createdAt])
}

/// Privacy-safe telemetry for admin: tracks tokens, models, duration, and user metrics WITHOUT storing private transcript content.
model UsageMetric {
  id                 String   @id @default(cuid())
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  model              String   @default("gemini-2.5-flash-lite")
  inputType          String   // "file" | "url" | "batch" | "voice"
  fileFormat         String?  // "mp3" | "wav" | "mp4" etc.
  fileSizeBytes      Int?
  durationSeconds    Float?
  wordCount          Int?
  estimatedInputTokens  Int   @default(0)
  estimatedOutputTokens Int   @default(0)
  totalTokens        Int      @default(0)
  status             String   @default("success") // "success" | "error"
  keyIndex           Int?     @default(0)
  latencyMs          Int?
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([model])
  @@index([status])
  @@index([keyIndex])
}

/// Error report log for admins to diagnose and fix issues for users.
model ErrorLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  endpoint     String   // "/api/transcribe" | "/api/report"
  errorMessage String
  errorType    String?  // "API_TIMEOUT" | "RATE_LIMIT" | "INVALID_FORMAT" | "NETWORK_ERROR" etc.
  model        String?
  fileFormat   String?
  metadata     String?  // JSON metadata (file size, duration, status code, IP etc.)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// Audit log tracking sensitive operations performed by system administrators.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String?
  action     String   // "ROLE_CHANGE" | "USER_DELETE" | "CLEAR_ERRORS" | "PING_FLEET" | "SYSTEM_SETTING"
  targetId   String?  // Target user, resource, or setting id
  metadata   String?  // JSON stringified context
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}
