# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-your-db-host.neon.tech/neondb?sslmode=require"

# NextAuth Configuration
NEXTAUTH_URL="https://your-domain.vercel.app"
NEXTAUTH_SECRET="your_nextauth_secret_key_here"
ADMIN_EMAILS="admin@example.com"

# Resend Email Service
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="Signal <onboarding@resend.dev>"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Gemini AI
GEMINI_API_KEY="AIzaSy_your_gemini_api_key_here"
GEMINI_API_KEYS="AIzaSy_your_gemini_key_1,AIzaSy_your_gemini_key_2"
GEMINI_MODEL="gemini-2.5-flash-lite"
GEMINI_MODELS="gemini-2.5-flash-lite,gemini-2.5-flash"
# Optional local development demo. Production always requires Gemini credentials.
ENABLE_GEMINI_DEMO=false
# Enable durable queue delivery after the Vercel queue consumer has been verified.
TRANSCRIPTION_QUEUE_ENABLED=false
GEMINI_API_HOST="gemini-proxy.vsuon54.workers.dev"

# Telegram Bot Real-Time Error Alerting
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_BOT_USERNAME="transcript_signal_bot"
# Required for authenticated Telegram webhook delivery in production.
TELEGRAM_WEBHOOK_SECRET=""
# Individual Telegram user IDs allowed to operate the server (comma separated).
# Required when TELEGRAM_CHAT_ID is a group; a group ID does not authorize its members.
TELEGRAM_ADMIN_USER_IDS=""
